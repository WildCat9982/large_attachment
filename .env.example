# Copy to .env and fill in the key for the provider you use.

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-4-5-20251001

# For OpenAI or any OpenAI-compatible endpoint instead:
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# LLM_MODEL=
# LLM_FAST_MODEL=

# Cost guard for summaries: max sections read per document (0 = read everything).
SUMMARY_MAX_WINDOWS=150
